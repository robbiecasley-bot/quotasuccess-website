# Copy to .env for local `netlify dev`. In production, set these as
# environment variables in the Netlify dashboard instead — never commit
# the real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: tune the submit-lead rate limit. Defaults shown below.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MINUTES=10

# Optional: formatted email notification per submission, sent via Resend
# (resend.com). If any of these three are missing, submit-lead.js simply
# skips sending the email — the lead is still saved either way. See
# DEPLOY.md for how to get an API key and verify the sending domain.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM="QuotaSuccess Leads <leads@quotasuccess.com.au>"
# RESEND_TO=robbie@quotasuccess.com.au
